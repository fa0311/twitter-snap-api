{
  "name": "twitter-snap-api",
  "version": "1.0.0",
  "description": "A simple API server for Twitter Snap",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "check": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/standard-validator": "^0.4.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@types/fluent-ffmpeg": "^2.1.28",
    "async-mutex": "^0.5.0",
    "dotenv": "^18.0.7",
    "fluent-ffmpeg": "^2.1.3",
    "hono": "^4.13.13",
    "hono-openapi": "^1.3.5",
    "twitter-snap": "^0.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@vitest/ui": "^5.0.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@12.11.2"
}
